# Metrotech ERF bootstrap infrastructure settings.
# Application-level configuration is managed from Admin > App Management.

PORT=8080
NODE_ENV=production

# PostgreSQL bootstrap connection
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=metrotech_erf
POSTGRES_USER=metrotech_erf
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Required in production.
# Generate once, keep it outside the database, and reuse it when restoring/migrating
# the same database so encrypted App Management secrets remain decryptable.
APP_CONFIG_MASTER_KEY=replace-with-a-long-random-secret

# Persistent application storage
PDF_DIR=/data/pdfs
PROFILE_SIGNATURE_DIR=/data/pdfs/profile-signatures
MAX_EVIDENCE_MB=15

# Local renderer is the production form renderer.
PDF_MODE=mock

# Everything below is configured in Admin > App Management:
# - App Base URL / HTTPS URL
# - Timezone
# - Local Login / Google Workspace
# - Google OAuth Client ID / Client Secret / Callback / allowed domain
# - SMTP host / port / credentials
# - no-reply sender / override recipient / final approved CC
# - Session lifetime / Secure Cookie / login rate limit
# - Session Secret rotation
